const express = require('express');
const router = express.Router();
const { InfluxDB } = require('@influxdata/influxdb-client');

const influxDB = new InfluxDB({
  url: process.env.INFLUXDB_URL,
  token: process.env.INFLUXDB_TOKEN
});
const queryApi = influxDB.getQueryApi(process.env.ORG);
const BUCKET = process.env.BUCKET;

// Thresholds
const thresholds = {
  moisture: { critical: 20, medium: 30 },
  temperature: { warning: 35 },
};

// GET /api/alerts
router.get('/', async (req, res) => {
  try {
    const devices = ["esp32_node_01"]; // list your devices here or fetch dynamically
    const alerts = [];

    const now = new Date();
    const offlineThreshold = new Date(now.getTime() - 10 * 60 * 1000); // 10 min

    for (const deviceId of devices) {
      // fetch latest sensor data
      const query = `
        from(bucket: "${BUCKET}")
          |> range(start: -10m)
          |> filter(fn: (r) => r._measurement == "agri_telemetry")
          |> filter(fn: (r) => r.device_id == "${deviceId}")
          |> last()
          |> pivot(rowKey:["_time"], columnKey: ["_field"], valueColumn: "_value")
      `;

      let result = {};
      await new Promise((resolve, reject) => {
        queryApi.queryRows(query, {
          next(row, tableMeta) {
            const o = tableMeta.toObject(row);
            result = {
              temperature: o.temperature_c,
              moisture: o.soil_moisture_pct,
              humidity: o.humidity_pct,
              light: o.light_raw,
              timestamp: o._time,
            };
          },
          error(err) { reject(err); },
          complete() { resolve(); }
        });
      });

      // Device offline alert
      if (!result.timestamp || new Date(result.timestamp) < offlineThreshold) {
        alerts.push({
          id: `${deviceId}-offline`,
          message: `${deviceId} is offline`,
          severity: "critical",
          zoneId: deviceId,
          timestamp: now.toISOString(),
        });
        continue; // skip other checks if offline
      }

      // Moisture alerts
      if (result.moisture !== undefined) {
        if (result.moisture < thresholds.moisture.critical) {
          alerts.push({
            id: `${deviceId}-moisture-critical`,
            message: `Soil moisture critically low (${result.moisture}%)`,
            severity: "critical",
            zoneId: deviceId,
            timestamp: result.timestamp,
          });
        } else if (result.moisture < thresholds.moisture.medium) {
          alerts.push({
            id: `${deviceId}-moisture-medium`,
            message: `Soil moisture below optimal (${result.moisture}%)`,
            severity: "medium",
            zoneId: deviceId,
            timestamp: result.timestamp,
          });
        }
      }

      // Temperature alerts
      if (result.temperature !== undefined && result.temperature > thresholds.temperature.warning) {
        alerts.push({
          id: `${deviceId}-temperature-warning`,
          message: `Temperature high (${result.temperature}°C)`,
          severity: "medium",
          zoneId: deviceId,
          timestamp: result.timestamp,
        });
      }
    }

    res.json(alerts);
  } catch (err) {
    console.error("Alerts generation error:", err);
    res.status(500).json({ error: err.message });
  }
});

module.exports = router;